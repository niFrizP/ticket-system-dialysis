# =============================================================================
# ENTORNO
# =============================================================================
APP_ENV=production
# production | development

# =============================================================================
# BASE DE DATOS
# =============================================================================
DB_HOST=localhost
DB_NAME=teqmedcl_intranet
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# =============================================================================
# CORREO (PHPMailer / SMTP)
# =============================================================================
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# tls | ssl | (vacío para sin cifrado)

MAIL_FROM_ADDRESS=no-reply@teqmed.cl
MAIL_FROM_NAME="TEQMED SpA"

# =============================================================================
# CLOUDFLARE TURNSTILE (anti-bot)
# Obtén tus claves en: https://dash.cloudflare.com/?to=/:account/turnstile
# =============================================================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# =============================================================================
# SENTRY (monitoreo de errores)
# Obtén tu DSN en: https://sentry.io → Project Settings → Client Keys
# Dejar vacío para deshabilitar Sentry
# =============================================================================
SENTRY_DSN=
SENTRY_DEBUG=0
# 1 habilita logs adicionales de Sentry (solo en desarrollo)